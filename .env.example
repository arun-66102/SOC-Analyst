# =============================================================================
# .env.example
# ------------
# Copy this file to `.env` and fill in your actual keys.
# NEVER commit the real `.env` file to Git — it is already in .gitignore.
#
# In production (Vercel), set these as Environment Variables in the
# Vercel dashboard: Project → Settings → Environment Variables
#
# Author : Member 1 — Project Lead
# =============================================================================

# ---------------------------------------------------------------------------
# Groq Cloud API  (LLM — only provider)
# ---------------------------------------------------------------------------
# Sign up free at: https://console.groq.com
# Free tier: 14,400 req/day · 30 req/min · no credit card needed
#
# NOTE: Groq does NOT host GPT models — those are OpenAI proprietary.
# Groq runs open-source models (LLaMA 3, Mixtral, DeepSeek) on LPU hardware.
GROQ_API_KEY=your_groq_api_key_here

# ---------------------------------------------------------------------------
# Task-specific models  (each agent uses the model best suited for its job)
# ---------------------------------------------------------------------------
# Defaults are verified active on Groq as of Aug 2026.
# Override any of these in your .env without touching code.
# Live model list: curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
#
#  Task            Default model                      Why
#  ─────────────   ─────────────────────────────────  ──────────────────────────────────────
#  Triage          openai/gpt-oss-120b                Best accuracy for severity classification
#  Correlation     llama-3.1-8b-instant               Fastest — high-volume event grouping
#  MITRE Mapping   openai/gpt-oss-120b                Precision matters for ATT&CK tagging
#  Enrichment      llama-3.1-8b-instant               Simple lookups, speed over depth
#  Report          deepseek-r1-distill-llama-70b      Best chain-of-thought investigation

GROQ_MODEL_TRIAGE=openai/gpt-oss-120b
GROQ_MODEL_CORRELATION=llama-3.1-8b-instant
GROQ_MODEL_MITRE=openai/gpt-oss-120b
GROQ_MODEL_ENRICHMENT=llama-3.1-8b-instant
GROQ_MODEL_REPORT=deepseek-r1-distill-llama-70b

# Generation parameters (apply to all tasks unless overridden per-call)
GROQ_TEMPERATURE=0.1     # Low = more deterministic, consistent SOC decisions
GROQ_MAX_TOKENS=2048     # Max tokens per LLM response

# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL)
# ---------------------------------------------------------------------------
# Create a free project at: https://neon.tech  (no credit card needed)
# Format: postgresql://user:password@host/dbname?sslmode=require
NEON_DB_URL=postgresql://username:password@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# Connection pool sizes (leave defaults for prototyping)
DB_POOL_MIN=1
DB_POOL_MAX=5

# ---------------------------------------------------------------------------
# Threat Intelligence APIs (both free — no credit card needed)
# ---------------------------------------------------------------------------

# VirusTotal Free API — 4 req/min · 500 req/day
# Sign up at: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# AbuseIPDB Free API — 1000 req/day
# Sign up at: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# ---------------------------------------------------------------------------
# FastAPI / App settings
# ---------------------------------------------------------------------------

# Environment: "development" | "production"
APP_ENV=development

# FastAPI host and port for local development
APP_HOST=127.0.0.1
APP_PORT=8000

# Secret key for signing JWT tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# CORS — allowed origins for the React frontend
# React (Vite) runs on http://localhost:5173 in development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Agent pipeline settings
# ---------------------------------------------------------------------------

# Correlation time window in seconds
# Events from the same source IP within this window are grouped into one incident
CORRELATION_WINDOW_SECONDS=300

# Max events to process per pipeline run in development mode
DEV_MAX_EVENTS=100

# Path to pre-built FAISS index for MITRE technique embeddings
FAISS_INDEX_PATH=data/processed/mitre_faiss.index

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO